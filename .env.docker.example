# =============================================================================
# COSECHA EN COPE - CONFIGURACIÓN DOCKER COMPOSE
# =============================================================================

# Base de datos PostgreSQL
POSTGRES_DB=cosechaencope
POSTGRES_USER=cosecha_user
POSTGRES_PASSWORD=cosecha_secure_password_123
POSTGRES_PORT=5432

# Aplicación
APP_PORT=8081

# Seguridad JWT
# Genera una clave propia en Base64 (minimo 32 bytes): openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTA_CLAVE
JWT_EXPIRATION_MS=86400000

# AWS S3 (Opcional en desarrollo)
AWS_ACCESS_KEY_ID=tu_aws_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret
AWS_REGION=eu-west-1
AWS_S3_BUCKET_NAME=cosechaencope-bucket
